<Window x:Class="z1.Views.StudentProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прогресс студента" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding LastName, StringFormat='Студент: {0}'}" FontSize="16" Margin="0,0,0,10"/>
        <ListView Grid.Row="1" ItemsSource="{Binding Enrollments}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Курс" DisplayMemberBinding="{Binding Course.Name}" Width="150"/>
                    <GridViewColumn Header="Оценка" DisplayMemberBinding="{Binding Grade}" Width="50"/>
                    <GridViewColumn Header="Комментарий" DisplayMemberBinding="{Binding Comment}" Width="200"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" Text="{Binding AverageGrade, StringFormat='Средний балл: {0:N2}'}" FontSize="14" Margin="0,10,0,0"/>
    </Grid>
</Window>